# Bee Driver App - Environment Configuration
# Copy this file to .env and fill in the values

# API base URL (REST) — must include /api suffix
# For production: https://ebee.lk/api
EXPO_PUBLIC_API_URL=https://ebee.lk/api

# WebSocket URL (STOMP) — must include /ws/websocket suffix
# For production: wss://ebee.lk/ws/websocket
EXPO_PUBLIC_WS_URL=wss://ebee.lk/ws/websocket
